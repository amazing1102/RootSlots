# 统一行尾:文本文件仓库内一律 LF(避免 Windows 提交产生 CRLF 噪音)
* text=auto eol=lf

# 例外:Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换、不参与文本 diff
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.apk binary
*.aab binary
*.jar binary
*.aar binary
*.ttf binary
*.otf binary
*.onnx binary
*.db binary
*.zip binary
*.7z binary
*.keystore binary
*.jks binary
*.dict binary
*.dict.cache binary

# 第三方数据/模型不参与 diff 统计(它们体积大且非源码)
RootSlots/app/src/main/assets/tts/** -diff
RootSlots/app/libs/** -diff
